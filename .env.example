# Copy to .env and adjust values locally. Never commit .env.
API_MODEL_PATH=model_registry/model.onnx
API_MODEL_BACKEND=auto
API_DEVICE=cpu
LOG_LEVEL=INFO
LOG_JSON=1

# MLflow tracking (local file store by default)
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=industrial-defect-detection

# Frontend
VITE_API_URL=http://localhost:8000

# GitHub feedback sync (API -> GitHub -> CT)
# Fine-grained PAT with "Contents: Read and write" (Contents API + repository_dispatch).
# Optional classic PAT scope: repo. Never commit the real token.
GITHUB_TOKEN=
GITHUB_REPO=Zahrat-ElOula/MLOps---Detection-de-defauts-industriels-
GITHUB_BRANCH=main
FEEDBACK_RETRY_SECONDS=300
GITHUB_TIMEOUT_SECONDS=10
